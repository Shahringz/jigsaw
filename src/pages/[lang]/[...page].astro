---
import LocalizedPage from '../../components/LocalizedPage.astro';
import { locales, pages } from '../../i18n';

export function getStaticPaths() {
  return locales.flatMap((lang) => pages.map((page) => ({
    params: { lang, page: page === 'home' ? undefined : page },
    props: { lang, page },
  })));
}

const { lang, page } = Astro.props;
---
<LocalizedPage lang={lang} page={page} />
