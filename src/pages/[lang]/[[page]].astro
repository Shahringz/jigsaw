---
import Layout from '../../layouts/Layout.astro';
import {home,paths,industries,about,services,process,faq,copy} from '../../data/content.js';
export function getStaticPaths(){return ['fa','en'].flatMap(lang=>['','about','services','work','process','contact'].map(page=>({params:{lang,page:page||undefined},props:{lang,page}})));}
const {lang,page}=Astro.props;
const t=copy[lang],h=home[lang],isFa=lang==='fa';
const href=(slug='')=>'/'+lang+(slug?'/'+slug:'');
const titles={'':h.title,about:about[lang][0][0],services:t.servicesTitle,work:t.workTitle,process:t.processTitle,contact:t.contactTitle};
const descriptions={'':h.intro,about:about[lang][0][1],services:t.servicesIntro,work:t.workEmpty,process:t.processIntro,contact:t.contactIntro};
const selection=Astro.url.searchParams.get('service')||'';
---
<Layout lang={lang} page={page} title={titles[page]+' | JIGSAW'} description={descriptions[page]}>
{page===''&&<>
<section class="container hero"><div class="poster"><img src="/Jigsaw_Cover_EN.png" width="900" height="1200" alt={isFa?'جلد جیگزا با دو شخصیت که قطعه‌های زرد و قرمز پازل را کنار هم می‌گذارند. روی جلد، شعار انگلیسیِ «هر قطعه، در جای درست» آمده است.':'JIGSAW agency cover. Two illustrated figures fit yellow and red puzzle pieces together above the line ‘Every piece in its place.’'}/></div><div><span class="eyebrow">JIGSAW / CREATIVE STUDIO</span><h1>{h.title}</h1><p>{h.intro}</p><div class="actions"><a class="button" href={href('contact')}>{h.start}</a><a class="button secondary" href={href('services')}>{h.explore}</a></div></div></section>
<section class="container"><h2 class="section-title">{h.paths}</h2><div class="grid">{paths[lang].map(([title,desc],i)=><a class="card" href={href('services')+'#service-'+[1,3,6][i]}><span class="number">0{i+1}</span><h3>{title}</h3><p>{desc}</p></a>)}</div><div class="actions"><a class="button secondary" href={href('services')}>{h.all}</a></div></section>
<section class="container"><h2 class="section-title">{h.industries}</h2><div class="grid">{industries[lang].map(([title,desc])=><article class="card"><h3>{title}</h3><p>{desc}</p></article>)}</div></section>
</>}
{page==='about'&&<><section class="container intro"><span class="eyebrow">ABOUT / JIGSAW</span><h1>{about[lang][0][0]}</h1><div class="line"></div><p>{about[lang][0][1]}</p></section><section class="container stack">{about[lang].slice(1).map(([title,desc])=><article><h2>{title}</h2><p>{desc}</p></article>)}<p>{isFa?'خدمات جیگزا برای کسب‌وکارهای ایران، عمان و امارات قابل ارائه است.':'We can work with businesses in Iran, Oman and the UAE.'}</p><a class="button" href={href('process')}>{t.aboutLink}</a></section></>}
{page==='services'&&<><section class="container intro"><span class="eyebrow">SERVICES / 08</span><h1>{t.servicesTitle}</h1><p>{t.servicesIntro}</p></section><section class="container stack">{services.map((s,i)=><article id={'service-'+i}><span class="eyebrow">0{i+1} / 08</span><h2>{s[lang]}</h2><p>{s[lang+'Text']}</p><a class="button secondary" href={href('contact')+'?service='+i}>{t.discuss}</a></article>)}</section></>}
{page==='process'&&<><section class="container intro"><span class="eyebrow">PROCESS / JIGSAW</span><h1>{t.processTitle}</h1><p>{t.processIntro}</p></section><section class="container"><div class="stack">{process[lang].map(([title,desc],i)=><article><span class="eyebrow">0{i+1}</span><h2>{title}</h2><p>{desc}</p></article>)}</div><div style="margin-top:70px">{faq[lang].map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section></>}
{page==='work'&&<><section class="container intro"><span class="eyebrow">WORK / JIGSAW</span><h1>{t.workTitle}</h1><p>{t.workEmpty}</p><div class="actions"><a class="button" href={href('contact')+'?service=related'}>{t.workAction}</a></div></section></>}
{page==='contact'&&<><section class="container intro"><span class="eyebrow">CONTACT / JIGSAW</span><h1>{t.contactTitle}</h1><p>{t.contactIntro}</p></section><section class="container"><div class="notice" role="status">{t.preview}</div><form class="form-grid" id="enquiry-form" novalidate><div class="field"><label for="name">{t.fields[0]}</label><input id="name" name="name" required autocomplete="name"/></div><div class="field"><label for="business">{t.fields[1]}</label><input id="business" name="business" autocomplete="organization"/></div><div class="field"><label for="contact">{t.fields[2]}</label><input id="contact" name="contact" required autocomplete="email"/></div><div class="field"><label for="interest">{t.fields[3]}</label><select id="interest" name="interest">{services.map((s,i)=><option value={i} selected={selection===String(i)}>{s[lang]}</option>)}<option value="unsure">{t.other[0]}</option><option value="related" selected={selection==='related'}>{t.other[1]}</option></select></div><div class="field wide"><label for="message">{t.fields[4]}</label><textarea id="message" name="message" required placeholder={t.placeholder}></textarea></div><div class="field wide"><label for="reference">{t.fields[5]}</label><input id="reference" name="reference" type="url"/></div><div class="field wide"><button class="button" type="submit" disabled title={t.preview}>{t.submit}</button></div></form></section></>}
</Layout>