---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { assetHref, pageHref, translator, displayDate, blogCategories, languages, type Locale } from '../../../i18n';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => {
    const [lang, slug] = post.id.split('/');
    const alternates = Object.fromEntries(posts.filter(other => other.id.split('/')[1] === slug).map(other => {
      const locale = other.id.split('/')[0] as Locale;
      return [locale, pageHref(locale, 'blog') + slug + '/'];
    }));
    return { params: { lang, slug }, props: { post, lang: lang as Locale, alternates } };
  });
}
interface Props { post: CollectionEntry<'blog'>; lang: Locale; alternates: Partial<Record<Locale, string>> }
const { post, lang, alternates } = Astro.props;
const { Content } = await render(post);
const { title, description, image, imageAlt, date, author, relatedWork } = post.data;
const tr = translator(lang);
---
<Layout lang={lang} page="blog" metadata={[title + ' | JIGSAW', description]} alternates={alternates}>
  <article class="wrap inner post">
    <a class="textlink" href={pageHref(lang, 'blog')}>{tr('وبلاگ جیگزا', 'JIGSAW blog', 'مدوّنة جيغسو')}</a>
    <div class="intro"><h1>{title}</h1><p>{description}</p><small>{blogCategories[post.data.category][languages[lang].index]} · {author} · <time datetime={date.toISOString().slice(0, 10)}>{displayDate(date, lang)}</time></small></div>
    {image && <div class="post-art"><img src={assetHref(image)} alt={imageAlt ?? ''} width="600" height="800" /></div>}
    <div class="article-text"><Content />
      {relatedWork && <a class="textlink" href={pageHref(lang, 'work') + '#' + relatedWork}>{tr('دیدن اثر توی گالری', 'See the work in the gallery', 'شاهد العمل في المعرض')}</a>}
    </div>
  </article>
</Layout>
