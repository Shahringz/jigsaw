---
import { assetHref, pageHref } from '../i18n';
const translations = {
  fa: { dir: 'rtl', title: 'صفحه پیدا نشد', message: 'شاید آدرس تغییر کرده یا این صفحه دیگه وجود نداره.', home: 'بازگشت به صفحه اصلی', href: pageHref('fa') },
  en: { dir: 'ltr', title: 'Page not found', message: 'The address may have changed, or this page may no longer exist.', home: 'Back to home', href: pageHref('en') },
  ar: { dir: 'rtl', title: 'الصفحة غير موجودة', message: 'ربما تغيّر العنوان أو لم تعد هذه الصفحة موجودة.', home: 'العودة إلى الصفحة الرئيسية', href: pageHref('ar') },
};
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#22221f" />
    <title>صفحه پیدا نشد | JIGSAW</title>
    <link rel="icon" type="image/webp" href={assetHref('media/mark.webp')} />
    <style is:inline set:html={`
      @font-face { font-family: Estedad; src: url("${assetHref('type/estedad-fa.woff2')}") format("woff2"); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: Sora; src: url("${assetHref('type/sora-bold.woff2')}") format("woff2"); font-weight: 700; font-display: swap; }
      @font-face { font-family: Manrope; src: url("${assetHref('type/manrope.woff2')}") format("woff2"); font-weight: 200 800; font-display: swap; }
    `}></style>
    <script is:inline define:vars={{ translations }}>
      (() => {
        const prefix = location.pathname.split('/').filter(Boolean)[0];
        const lang = prefix === 'en' || prefix === 'ar' ? prefix : 'fa';
        const copy = translations[lang];
        document.documentElement.lang = lang;
        document.documentElement.dir = copy.dir;
        document.title = copy.title + ' | JIGSAW';
        document.addEventListener('DOMContentLoaded', () => {
          document.getElementById('error-title').textContent = copy.title;
          document.getElementById('error-message').textContent = copy.message;
          const home = document.getElementById('error-home');
          home.textContent = copy.home;
          home.href = copy.href;
          document.getElementById('brand-home').href = copy.href;
        });
      })();
    </script>
  </head>
  <body>
    <main>
      <div class="error-copy">
      <a id="brand-home" class="brand" href={translations.fa.href} dir="ltr"><img src={assetHref('media/mark.webp')} width="32" height="32" alt="" /> JIGSAW</a>
      <div class="error-code" aria-hidden="true" dir="ltr">404<span>.</span></div>
      <h1 id="error-title">{translations.fa.title}</h1>
      <p id="error-message">{translations.fa.message}</p>
      <a class="button" id="error-home" href={translations.fa.href}>{translations.fa.home}</a>
      </div>
      <div class="puzzle-stage" id="puzzle-stage" aria-hidden="true">
        <svg class="puzzle-fallback" viewBox="0 0 400 400" fill="none" focusable="false">
          <circle cx="200" cy="200" r="150" stroke="#f7f5ed" stroke-opacity=".17" stroke-dasharray="3 9"/>
          <circle cx="200" cy="200" r="118" stroke="#f7f5ed" stroke-opacity=".09"/>
          <g transform="translate(200 216) rotate(-14)">
            <path d="M-80 -80 H-24 C-34 -120 34 -120 24 -80 H80 V-24 C120 -34 120 34 80 24 V80 H24 C34 40 -34 40 -24 80 H-80 V24 C-40 34 -40 -34 -80 -24 Z" stroke="#f7f5ed" stroke-opacity=".35" stroke-width="2" stroke-dasharray="5 6" transform="translate(15 26)"/>
            <path d="M-80 -80 H-24 C-34 -120 34 -120 24 -80 H80 V-24 C120 -34 120 34 80 24 V80 H24 C34 40 -34 40 -24 80 H-80 V24 C-40 34 -40 -34 -80 -24 Z" fill="#9b6a0c" transform="translate(0 12)"/>
            <path d="M-80 -80 H-24 C-34 -120 34 -120 24 -80 H80 V-24 C120 -34 120 34 80 24 V80 H24 C34 40 -34 40 -24 80 H-80 V24 C-40 34 -40 -34 -80 -24 Z" fill="#f5bd13"/>
          </g>
          <circle cx="307" cy="98" r="4" fill="#ae373a"/>
          <circle cx="77" cy="277" r="3" fill="#f5bd13"/>
        </svg>
      </div>
    </main>
    <script is:inline type="module">
      const stage = document.getElementById('puzzle-stage');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      if (stage && !reduced.matches) {
        try {
          const T = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js');
          if (!reduced.matches && stage.isConnected) {
            const renderer = new T.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'low-power' });
            renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 1.75));
            renderer.outputColorSpace = T.SRGBColorSpace;
            renderer.setClearColor(0x22221f, 0);
            const scene = new T.Scene();
            const camera = new T.PerspectiveCamera(35, 1, 0.1, 50);
            camera.position.set(0, 0, 7.5);
            const key = new T.DirectionalLight(0xfff4da, 3.2);
            key.position.set(-3, 5, 7);
            scene.add(key, new T.HemisphereLight(0xffffff, 0x49330c, 1.5));
            const rim = new T.DirectionalLight(0xffffff, 1.2);
            rim.position.set(4, -2, 2);
            scene.add(rim);
            // True extruded puzzle geometry: two tabs and two sockets.
            const p = new T.Shape();
            p.moveTo(-1, -1);
            p.lineTo(-.3, -1);
            p.bezierCurveTo(-.47, -.48, .47, -.48, .3, -1);
            p.lineTo(1, -1); p.lineTo(1, -.3);
            p.bezierCurveTo(1.52, -.47, 1.52, .47, 1, .3);
            p.lineTo(1, 1); p.lineTo(.3, 1);
            p.bezierCurveTo(.47, 1.52, -.47, 1.52, -.3, 1);
            p.lineTo(-1, 1); p.lineTo(-1, .3);
            p.bezierCurveTo(-.48, .47, -.48, -.47, -1, -.3);
            p.closePath();
            const geom = new T.ExtrudeGeometry(p, { depth: .24, bevelEnabled: true, bevelSegments: 3, steps: 1, bevelSize: .045, bevelThickness: .045, curveSegments: 24 });
            geom.translate(0, 0, -.12);
            const face = new T.MeshStandardMaterial({ color: 0xf5bd13, roughness: .64, metalness: .03 });
            const edge = new T.MeshStandardMaterial({ color: 0xae7811, roughness: .78 });
            const piece = new T.Mesh(geom, [face, edge]);
            const pivot = new T.Group();
            pivot.add(piece);
            scene.add(pivot);
            const points = p.getPoints(60).map(v => new T.Vector3(v.x, v.y, 0));
            const outline = new T.LineLoop(new T.BufferGeometry().setFromPoints(points), new T.LineDashedMaterial({ color: 0xf7f5ed, dashSize: .055, gapSize: .065, transparent: true, opacity: .36 }));
            outline.computeLineDistances();
            outline.position.set(.22, -.28, -.55);
            outline.rotation.z = -.20;
            scene.add(outline);
            function ring(radius, opacity) {
              const pts = Array.from({ length: 128 }, (_, i) => {
                const a = i / 128 * Math.PI * 2;
                return new T.Vector3(Math.cos(a) * radius, Math.sin(a) * radius, -.85);
              });
              const line = new T.LineLoop(new T.BufferGeometry().setFromPoints(pts), new T.LineBasicMaterial({ color: 0xf7f5ed, transparent: true, opacity }));
              scene.add(line);
            }
            ring(1.72, .12); ring(2.02, .07);
            const marker = new T.Mesh(new T.SphereGeometry(.035, 12, 12), new T.MeshBasicMaterial({ color: 0xae373a }));
            scene.add(marker);
            renderer.domElement.setAttribute('aria-hidden', 'true');
            stage.append(renderer.domElement);
            let targetX = 0, targetY = 0, x = 0, y = 0, raf = 0, stopped = false;
            const resize = () => {
              const w = Math.max(1, stage.clientWidth), h = Math.max(1, stage.clientHeight);
              camera.aspect = w / h;
              camera.position.z = 7.5 * Math.max(1, 1 / camera.aspect);
              camera.updateProjectionMatrix();
              renderer.setSize(w, h, false);
            };
            const observer = new ResizeObserver(resize);
            observer.observe(stage);
            resize();
            stage.addEventListener('pointermove', e => {
              if (e.pointerType === 'touch') return;
              const rect = stage.getBoundingClientRect();
              targetX = (e.clientX - rect.left) / rect.width * 2 - 1;
              targetY = (e.clientY - rect.top) / rect.height * 2 - 1;
            }, { passive: true });
            stage.addEventListener('pointerleave', () => { targetX = targetY = 0; });
            const start = performance.now();
            function frame(now) {
              raf = 0;
              if (stopped || document.hidden || reduced.matches) return;
              const t = (now - start) / 1000;
              x += (targetX - x) * .065;
              y += (targetY - y) * .065;
              const wave = Math.sin(t * .9);
              pivot.position.set(-.06 + Math.sin(t * .55) * .09, .10 + wave * .17, .12 + wave * .10);
              pivot.rotation.set(.27 + y * .23 + Math.sin(t * .7) * .09, -.38 + x * .30 + Math.sin(t * .63) * .16, -.24 + Math.sin(t * .48) * .10);
              marker.position.set(Math.cos(t * .24) * 2.02, Math.sin(t * .24) * 2.02, -.85);
              renderer.render(scene, camera);
              stage.classList.add('is-rendered');
              raf = requestAnimationFrame(frame);
            }
            function stop() { if (raf) cancelAnimationFrame(raf); raf = 0; }
            function resume() { if (!raf && !stopped && !document.hidden && !reduced.matches) raf = requestAnimationFrame(frame); }
            document.addEventListener('visibilitychange', () => document.hidden ? stop() : resume());
            reduced.addEventListener('change', () => {
              if (reduced.matches) { stop(); stage.classList.remove('is-rendered'); }
              else resume();
            });
            renderer.domElement.addEventListener('webglcontextlost', e => {
              e.preventDefault(); stopped = true; stop(); stage.classList.remove('is-rendered');
            });
            window.addEventListener('pagehide', e => {
              stop();
              if (e.persisted) return;
              stopped = true; observer.disconnect();
              scene.traverse(obj => {
                obj.geometry?.dispose();
                const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
                mats.forEach(m => m?.dispose());
              });
              renderer.dispose();
            });
            window.addEventListener('pageshow', resume);
            resume();
          }
        } catch {
          // The localized page and static puzzle remain usable without WebGL or CDN access.
        }
      }
    </script>
  </body>
</html>
<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: #f7f5ed; color: #22221f; font: 1rem/1.8 Manrope, system-ui, sans-serif; }
  html[dir="rtl"] body { font-family: Estedad, Tahoma, sans-serif; }
  main { width: min(72rem, 88vw); min-height: 100vh; min-height: 100svh; margin-inline: auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 6vw, 5rem); padding-block: 3rem; }
  .error-copy { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .puzzle-stage { position: relative; aspect-ratio: 1; overflow: hidden; isolation: isolate; background: #22221f; border-radius: .5rem; }
  .puzzle-fallback, .puzzle-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .puzzle-stage canvas { opacity: 0; }
  .puzzle-stage.is-rendered canvas { opacity: 1; }
  .puzzle-stage.is-rendered .puzzle-fallback { visibility: hidden; }
  @media (max-width: 720px) { main { grid-template-columns: minmax(0, 1fr); width: min(29rem, 86vw); gap: 1.8rem; align-content: center; padding-block: 2rem; } .puzzle-stage { width: 100%; max-width: 25rem; justify-self: center; } .brand { margin-block-end: 1rem !important; } }
  .brand { display: inline-flex; align-items: center; gap: .55rem; color: inherit; font: 700 1.35rem Sora, sans-serif; text-decoration: none; margin-block-end: 2.5rem; }
  .brand img { object-fit: contain; }
  .error-code { font: 700 clamp(5rem, 12vw, 9rem)/1 Sora, sans-serif; letter-spacing: -.07em; }
  .error-code span { color: #f5bd13; }
  h1 { font-size: clamp(1.6rem, 5vw, 2.8rem); line-height: 1.4; margin-block: 1rem .5rem; }
  p { margin-block: 0 1.75rem; max-width: 45ch; }
  .button { background: #f5bd13; color: #22221f; padding: .65rem 1.25rem; border-radius: 100px; font-weight: 700; text-decoration: none; }
  a:focus-visible { outline: 3px solid #ae373a; outline-offset: 4px; }
</style>
