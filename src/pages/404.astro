---
import { assetHref, pageHref } from '../i18n';
const translations = {
  fa: { dir: 'rtl', title: 'صفحه پیدا نشد', message: 'به نظر می‌رسه یکی از قطعه‌های پازل گم شده.', home: 'بازگشت به صفحه اصلی', href: pageHref('fa') },
  en: { dir: 'ltr', title: 'Page not found', message: 'Looks like a piece of the puzzle is missing.', home: 'Back to home', href: pageHref('en') },
  ar: { dir: 'rtl', title: 'الصفحة غير موجودة', message: 'يبدو أن إحدى قطع الأحجية مفقودة.', home: 'العودة إلى الصفحة الرئيسية', href: pageHref('ar') },
};
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#22221f" />
    <title>صفحه پیدا نشد | JIGSAW</title>
    <link rel="icon" type="image/webp" href={assetHref('media/mark.webp')} />
    <style is:inline set:html={`
      @font-face { font-family: Estedad; src: url("${assetHref('type/estedad-fa.woff2')}") format("woff2"); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: Sora; src: url("${assetHref('type/sora-bold.woff2')}") format("woff2"); font-weight: 700; font-display: swap; }
      @font-face { font-family: Manrope; src: url("${assetHref('type/manrope.woff2')}") format("woff2"); font-weight: 200 800; font-display: swap; }
    `}></style>
    <script is:inline define:vars={{ translations }}>
      (() => {
        const prefix = location.pathname.split('/').filter(Boolean)[0];
        const lang = prefix === 'en' || prefix === 'ar' ? prefix : 'fa';
        const copy = translations[lang];
        document.documentElement.lang = lang;
        document.documentElement.dir = copy.dir;
        document.title = copy.title + ' | JIGSAW';
        document.addEventListener('DOMContentLoaded', () => {
          document.getElementById('error-title').textContent = copy.title;
          document.getElementById('error-message').textContent = copy.message;
          const home = document.getElementById('error-home');
          home.textContent = copy.home;
          home.href = copy.href;
          document.getElementById('brand-home').href = copy.href;
        });
      })();
    </script>
  </head>
  <body>
    <main>
      <a id="brand-home" class="brand" href={translations.fa.href} dir="ltr"><img src={assetHref('media/mark.webp')} width="32" height="32" alt="" /> JIGSAW</a>
      <div class="puzzle-stage" id="puzzle-stage" aria-hidden="true">
        <svg class="puzzle-fallback" viewBox="0 0 1000 420" fill="none" focusable="false" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="left-face" x1="0" y1="0" x2=".8" y2="1"><stop stop-color="#f5bd13"/><stop offset="1" stop-color="#d79b00"/></linearGradient>
            <linearGradient id="right-face" x1="0" y1="0" x2=".8" y2="1"><stop stop-color="#77746e"/><stop offset="1" stop-color="#454344"/></linearGradient>
            <linearGradient id="piece-face" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#ffe17c"/><stop offset=".45" stop-color="#f5bd13"/><stop offset="1" stop-color="#ce9100"/></linearGradient>
            <radialGradient id="handoff-halo"><stop stop-color="#f5bd13" stop-opacity=".12"/><stop offset="1" stop-color="#f5bd13" stop-opacity="0"/></radialGradient>
            <clipPath id="left-clip"><polygon points="-120,160 90,195 155,165 210,110 270,94 330,96 399,112 419,127 412,144 392,149 326,132 285,142 257,166 310,158 343,170 359,193 353,211 337,215 316,194 284,187 312,211 318,230 303,241 289,235 266,212 280,243 269,256 251,251 238,241 249,270 327,260 378,225 399,224 410,240 403,256 349,300 300,313 215,302 145,270 -120,295"/></clipPath>
            <clipPath id="right-clip"><polygon points="1120,102 914,149 858,116 791,100 738,108 682,132 624,164 617,178 628,189 650,187 704,162 734,171 746,196 703,219 661,218 629,205 610,209 605,223 619,237 661,253 705,256 686,270 647,262 629,268 631,285 677,300 720,294 752,278 744,294 707,310 707,322 726,331 760,320 805,286 848,261 910,252 1120,273"/></clipPath>
          </defs>
          <circle cx="510" cy="205" r="200" fill="url(#handoff-halo)"/>
          <g class="graphic-hand-yellow">
            <polygon points="-120,160 90,195 155,165 210,110 270,94 330,96 399,112 419,127 412,144 392,149 326,132 285,142 257,166 310,158 343,170 359,193 353,211 337,215 316,194 284,187 312,211 318,230 303,241 289,235 266,212 280,243 269,256 251,251 238,241 249,270 327,260 378,225 399,224 410,240 403,256 349,300 300,313 215,302 145,270 -120,295" fill="#986700" transform="translate(0 12)"/>
            <polygon id="left-outline" points="-120,160 90,195 155,165 210,110 270,94 330,96 399,112 419,127 412,144 392,149 326,132 285,142 257,166 310,158 343,170 359,193 353,211 337,215 316,194 284,187 312,211 318,230 303,241 289,235 266,212 280,243 269,256 251,251 238,241 249,270 327,260 378,225 399,224 410,240 403,256 349,300 300,313 215,302 145,270 -120,295" fill="url(#left-face)" stroke="#f9c63b" stroke-width="1.2"/>
            <g clip-path="url(#left-clip)">
              <path d="M-20 180 L155 165 L210 110 L270 94 L285 142 L257 166 L195 206 L145 270 L90 195 Z" fill="#fff1a8" opacity=".09"/>
              <path d="M145 270 L195 206 L238 241 L249 270 L327 260 L349 300 L300 313 L215 302 Z" fill="#a46c00" opacity=".15"/>
            </g>
          </g>
          <g class="graphic-hand-charcoal">
            <polygon points="1120,102 914,149 858,116 791,100 738,108 682,132 624,164 617,178 628,189 650,187 704,162 734,171 746,196 703,219 661,218 629,205 610,209 605,223 619,237 661,253 705,256 686,270 647,262 629,268 631,285 677,300 720,294 752,278 744,294 707,310 707,322 726,331 760,320 805,286 848,261 910,252 1120,273" fill="#2c2b29" transform="translate(0 12)"/>
            <polygon id="right-outline" points="1120,102 914,149 858,116 791,100 738,108 682,132 624,164 617,178 628,189 650,187 704,162 734,171 746,196 703,219 661,218 629,205 610,209 605,223 619,237 661,253 705,256 686,270 647,262 629,268 631,285 677,300 720,294 752,278 744,294 707,310 707,322 726,331 760,320 805,286 848,261 910,252 1120,273" fill="url(#right-face)" stroke="#969087" stroke-width="1.2"/>
            <g clip-path="url(#right-clip)">
              <path d="M914 149 L858 116 L791 100 L738 108 L704 162 L734 171 L795 159 L848 261 L910 252 Z" fill="#f7f5ed" opacity=".07"/>
              <path d="M848 261 L795 159 L746 196 L703 219 L705 256 L752 278 L805 286 Z" fill="#171715" opacity=".12"/>
            </g>
          </g>
          <g class="static-piece" transform="translate(511 206) rotate(-12) scale(.74)">
            <path d="M-66 -66 H-20 C-29 -103 29 -103 20 -66 H66 V-20 C103 -29 103 29 66 20 V66 H20 C29 29 -29 29 -20 66 H-66 V20 C-29 29 -29 -29 -66 -20 Z" fill="#a67105" transform="translate(6 12)"/>
            <path d="M-66 -66 H-20 C-29 -103 29 -103 20 -66 H66 V-20 C103 -29 103 29 66 20 V66 H20 C29 29 -29 29 -20 66 H-66 V20 C-29 29 -29 -29 -66 -20 Z" fill="url(#piece-face)" stroke="#ffe394" stroke-width="1.5"/>
          </g>
        </svg>
      </div>
      <div class="error-copy">
        <div class="error-code" aria-hidden="true" dir="ltr">404<span>.</span></div>
        <h1 id="error-title">{translations.fa.title}</h1>
        <p id="error-message">{translations.fa.message}</p>
        <a class="button" id="error-home" href={translations.fa.href}>{translations.fa.home}</a>
      </div>
    </main>
    <script is:inline type="module">
      const stage = document.getElementById('puzzle-stage');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      if (stage && !reduced.matches) {
        try {
          const T = await import('https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js');
          if (!reduced.matches && stage.isConnected) {
            const renderer = new T.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'low-power' });
            renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 1.75));
            renderer.outputColorSpace = T.SRGBColorSpace;
            renderer.toneMapping = T.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.05;
            renderer.setClearColor(0x22221f, 0);
            const scene = new T.Scene();
            const camera = new T.OrthographicCamera(-5, 5, 2.1, -2.1, .1, 50);
            camera.position.set(0, 0, 12);
            const key = new T.DirectionalLight(0xffefd5, 2.1);
            key.position.set(-2, 5, 6);
            scene.add(key, new T.HemisphereLight(0xf7f5ed, 0x4b4843, 1.35));
            const rim = new T.DirectionalLight(0xffe7bb, 1.65);
            rim.position.set(4, 2, -3);
            scene.add(rim);
            const centerLight = new T.PointLight(0xffcf74, 1.6, 3, 2);
            centerLight.position.set(0, .12, .8);
            scene.add(centerLight);

            // Extrude the exact validated graphic silhouettes, not anatomical hands.
            // Use the same source points as the accessible SVG fallback.
            function makeHand(id, color, edgeColor) {
              const polygon = document.getElementById(id).points;
              const shape = new T.Shape();
              for (let i = 0; i < polygon.numberOfItems; i++) {
                const point = polygon.getItem(i);
                const px = (point.x - 500) / 100;
                const py = (210 - point.y) / 100;
                if (i === 0) shape.moveTo(px, py); else shape.lineTo(px, py);
              }
              shape.closePath();
              const geo = new T.ExtrudeGeometry(shape, {
                depth: .105, steps: 1, bevelEnabled: true,
                bevelSegments: 2, bevelThickness: .016, bevelSize: .012
              });
              const face = new T.MeshStandardMaterial({color, roughness:.87, metalness:0});
              const edge = new T.MeshStandardMaterial({color:edgeColor, roughness:.84, metalness:0});
              const mesh = new T.Mesh(geo, [face, edge]);
              mesh.position.z = -.22;
              const group = new T.Group();
              group.add(mesh);
              scene.add(group);
              return group;
            }
            const left = makeHand('left-outline', 0xeeb202, 0x9d6c04);
            const right = makeHand('right-outline', 0x4b494a, 0x2d2c2b);
            const p = new T.Shape();
            p.moveTo(-1,-1);p.lineTo(-.3,-1);p.bezierCurveTo(-.47,-.48,.47,-.48,.3,-1);
            p.lineTo(1,-1);p.lineTo(1,-.3);p.bezierCurveTo(1.52,-.47,1.52,.47,1,.3);
            p.lineTo(1,1);p.lineTo(.3,1);p.bezierCurveTo(.47,1.52,-.47,1.52,-.3,1);
            p.lineTo(-1,1);p.lineTo(-1,.3);p.bezierCurveTo(-.48,.47,-.48,-.47,-1,-.3);p.closePath();
            const geom=new T.ExtrudeGeometry(p,{depth:.28,bevelEnabled:true,bevelSegments:4,steps:1,bevelSize:.055,bevelThickness:.045,curveSegments:24});
            geom.translate(0,0,-.14);
            const piece=new T.Mesh(geom,[new T.MeshStandardMaterial({color:0xf5bd13,emissive:0x8c5300,emissiveIntensity:.16,roughness:.36,metalness:.06}),new T.MeshStandardMaterial({color:0xba8413,roughness:.53})]);
            const pivot=new T.Group();pivot.add(piece);pivot.scale.setScalar(.49);scene.add(pivot);
            renderer.domElement.setAttribute('aria-hidden', 'true');
            stage.append(renderer.domElement);
            let targetX = 0, targetY = 0, x = 0, y = 0, raf = 0, stopped = false;
            const resize = () => {
              const w = Math.max(1, stage.clientWidth), h = Math.max(1, stage.clientHeight);
              const aspect=w/h, artAspect=1000/420, halfWidth=5*Math.max(1,aspect/artAspect), halfHeight=halfWidth/aspect;
              camera.left=-halfWidth;camera.right=halfWidth;camera.top=halfHeight;camera.bottom=-halfHeight;
              camera.updateProjectionMatrix();
              renderer.setSize(w, h, false);
            };
            const observer = new ResizeObserver(resize);
            observer.observe(stage);
            resize();
            stage.addEventListener('pointermove', e => {
              if (e.pointerType === 'touch') return;
              const rect = stage.getBoundingClientRect();
              targetX = (e.clientX - rect.left) / rect.width * 2 - 1;
              targetY = (e.clientY - rect.top) / rect.height * 2 - 1;
            }, { passive: true });
            stage.addEventListener('pointerleave', () => { targetX = targetY = 0; });
            const start = performance.now();
            function frame(now) {
              raf = 0;
              if (stopped || document.hidden || reduced.matches) return;
              const t = (now - start) / 1000;
              x += (targetX - x) * .065;
              y += (targetY - y) * .065;
              const wave=Math.sin(t*1.05);
              const approach=(1-Math.cos(t*.85))*.5;
              left.position.x=-.10+approach*.045;
              right.position.x=.10-approach*.045;
              left.rotation.x=-.075+y*.025;
              right.rotation.x=-.075+y*.025;
              pivot.position.set(.11+x*.045,.04+wave*.065,.24);
              pivot.rotation.set(.18+y*.12,-.28+x*.17+Math.sin(t*.7)*.12,.20+wave*.045);
              centerLight.position.copy(pivot.position);
              centerLight.position.z+=.7;
              renderer.render(scene, camera);
              stage.classList.add('is-rendered');
              raf = requestAnimationFrame(frame);
            }
            function stop() { if (raf) cancelAnimationFrame(raf); raf = 0; }
            function resume() { if (!raf && !stopped && !document.hidden && !reduced.matches) raf = requestAnimationFrame(frame); }
            document.addEventListener('visibilitychange', () => document.hidden ? stop() : resume());
            reduced.addEventListener('change', () => {
              if (reduced.matches) { stop(); stage.classList.remove('is-rendered'); }
              else resume();
            });
            renderer.domElement.addEventListener('webglcontextlost', e => {
              e.preventDefault(); stopped = true; stop(); stage.classList.remove('is-rendered');
            });
            window.addEventListener('pagehide', e => {
              stop();
              if (e.persisted) return;
              stopped = true; observer.disconnect();
              scene.traverse(obj => {
                obj.geometry?.dispose();
                const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
                mats.forEach(m => m?.dispose());
              });
              renderer.dispose();
            });
            window.addEventListener('pageshow', resume);
            resume();
          }
        } catch {
          // The localized page and static puzzle remain usable without WebGL or CDN access.
        }
      }
    </script>
  </body>
</html>
<style is:global>
  * { box-sizing:border-box; }
  body { margin:0; background:#22221f; color:#f7f5ed; font:1rem/1.8 Manrope,system-ui,sans-serif; }
  html[dir="rtl"] body { font-family:Estedad,Tahoma,sans-serif; }
  main { width:min(76rem,94vw); min-height:100vh; min-height:100svh; margin-inline:auto; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:1rem 0 2rem; }
  .brand { align-self:flex-start; display:inline-flex; align-items:center; gap:.55rem; color:inherit; font:700 1.35rem Sora,sans-serif; text-decoration:none; margin-block-end:.15rem; }
  .brand img { object-fit:contain; }
  .puzzle-stage { position:relative; width:min(100vw,1440px); aspect-ratio:2.65; max-height:48vh; overflow:hidden; isolation:isolate; background:radial-gradient(ellipse at 51% 48%,#3d3525 0%,#292721 32%,#22221f 69%); }
  .puzzle-fallback,.puzzle-stage canvas { position:absolute; inset:0; width:100%; height:100%; display:block; }
  .puzzle-stage canvas { opacity:0; }
  .puzzle-stage.is-rendered canvas { opacity:1; }
  .puzzle-stage.is-rendered .puzzle-fallback { visibility:hidden; }
  .graphic-hand-yellow { animation: yellow-approach 7s ease-in-out infinite; }
  .graphic-hand-charcoal { animation: charcoal-approach 7s ease-in-out infinite; }
  @keyframes yellow-approach { 0%,100% { transform:translateX(-8px); } 50% { transform:translateX(0); } }
  @keyframes charcoal-approach { 0%,100% { transform:translateX(8px); } 50% { transform:translateX(0); } }
  @media(prefers-reduced-motion:reduce) { .graphic-hand-yellow,.graphic-hand-charcoal { animation:none; } }
  .error-copy { display:flex; flex-direction:column; align-items:center; text-align:center; margin-top:0; position:relative; }
  .error-code { font:700 clamp(4rem,8vw,6.5rem)/1 Sora,sans-serif; letter-spacing:-.075em; color:#f7f5ed; }
  .error-code span { color:#f5bd13; }
  h1 { font-size:clamp(1.5rem,4vw,2.45rem); line-height:1.4; margin-block:.7rem .4rem; }
  p { margin-block:0 1.4rem; max-width:49ch; color:#cfc9bd; }
  .button { background:#f5bd13; color:#22221f; padding:.7rem 1.45rem; border-radius:100px; font-weight:700; text-decoration:none; }
  .button:hover { background:#ffd153; }
  a:focus-visible { outline:3px solid #f5bd13; outline-offset:5px; }
  @media(max-width:720px) { main { width:94vw; padding:1.3rem 0 2.5rem; } .brand { margin-inline-start:3vw; } .puzzle-stage { width:100vw; aspect-ratio:2.1; max-height:none; } .error-copy { width:90%; margin-top:0; } }
</style>
