---
import { assetHref } from '../i18n';
const icon = (name: string) => assetHref('icons/jigsaw-a/' + name);
---
<link rel="icon" href={icon('favicon.ico')} sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" sizes="16x16" href={icon('favicon-16x16.png')} />
<link rel="icon" type="image/png" sizes="32x32" href={icon('favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="48x48" href={icon('favicon-48x48.png')} />
<link rel="icon" type="image/svg+xml" sizes="any" href={icon('favicon.svg')} />
<link rel="apple-touch-icon" sizes="180x180" href={icon('apple-touch-icon.png')} />
<link rel="mask-icon" href={icon('safari-pinned-tab.svg')} color="#414141" />
<link rel="manifest" href={icon('site.webmanifest')} />
