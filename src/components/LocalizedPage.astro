---
import { Gallery } from './Gallery';
import { StudioContent } from './Studio';
import Layout from '../layouts/Layout.astro';
import type { Locale, PageKey } from '../i18n';

interface Props {
  lang: Locale;
  page: PageKey;
}
const { lang, page } = Astro.props;
---
<Layout lang={lang} page={page}>
  {page === 'work'
    ? <Gallery fa={lang === 'fa'} client:load />
    : <StudioContent language={lang} page={page} />}
</Layout>
