---
import { Gallery } from './Gallery';
import { StudioContent } from './Studio';
import Network from './Network.astro';
import Blog from './Blog.astro';
import Layout from '../layouts/Layout.astro';
import type { Locale, PageKey } from '../i18n';

interface Props {
  lang: Locale;
  page: PageKey;
}
const { lang, page } = Astro.props;
---
<Layout lang={lang} page={page}>
  {page === 'work'
    ? <Gallery language={lang} client:load />
    : page === 'blog' ? <Blog lang={lang} />
    : page === 'network' || page === 'network/sbc' ? <Network lang={lang} profile={page === 'network/sbc'} />
    : <StudioContent language={lang} page={page} />}
</Layout>
