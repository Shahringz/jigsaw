---
import '../styles/site.css';
import { navigation, slugs, copy } from '../data/content.js';
import { base, defaultLocale, languages, locales, pageHref, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
  page?: string;
  title?: string;
  description?: string;
}

const { lang = defaultLocale, page = '', title = 'JIGSAW', description = '' } = Astro.props;
const isFa = lang === 'fa';
const labels = navigation[lang];
const menuLabel = isFa ? 'باز کردن منو' : 'Open menu';
const closeLabel = isFa ? 'بستن منو' : 'Close menu';
const absolutePage = (locale: Locale) => new URL(pageHref(locale, page), Astro.site ?? Astro.url);
---
<!doctype html>
<html lang={lang} dir={languages[lang].direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#20201f" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={absolutePage(lang)} />
    {locales.map((locale) => <link rel="alternate" hreflang={locale} href={absolutePage(locale)} />)}
    <link rel="alternate" hreflang="x-default" href={absolutePage(defaultLocale)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={pageHref(lang)} aria-label={isFa ? 'صفحهٔ اصلی جیگزا' : 'JIGSAW home'} dir="ltr">
        <span class="puzzle" aria-hidden="true">✦</span> JIGSAW<span class="dot">.</span>
      </a>
      <nav id="site-nav" aria-label={isFa ? 'منوی اصلی' : 'Main navigation'}>
        {slugs.map((slug, index) => (
          <a href={pageHref(lang, slug)} aria-current={page === slug ? 'page' : undefined}>
            {labels[index]}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <div class="language-switch" role="group" aria-label={isFa ? 'زبان سایت' : 'Site language'} dir="ltr">
          {locales.map((locale) => (
            locale === lang ? (
              <span lang={locale} dir={languages[locale].direction} aria-current="true">
                {languages[locale].label}
              </span>
            ) : (
              <a data-language-switch href={pageHref(locale, page)} hreflang={locale} lang={locale} dir={languages[locale].direction}>
                {languages[locale].label}
              </a>
            )
          ))}
        </div>
        <button id="menu-toggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav"
          aria-label={menuLabel} data-open-label={menuLabel} data-close-label={closeLabel}>
          <span aria-hidden="true">☰</span>
        </button>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <strong>JIGSAW<span class="dot">.</span></strong>
      <p>{copy[lang].footer}</p>
      <p>{copy[lang].regions}</p>
      <a href="https://jigsawstudio.ir">jigsawstudio.ir</a>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const icon = toggle?.querySelector('span');
      const nav = document.querySelector('#site-nav');
      const navLinks = nav?.querySelectorAll('a');

      if (toggle && icon && nav && navLinks) {
        const setMenuOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
          icon.textContent = open ? '✕' : '☰';
          nav.classList.toggle('open', open);
        };

        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          setMenuOpen(open);
          if (open) navLinks[0]?.focus();
        });
        navLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setMenuOpen(false);
            toggle.focus();
          }
        });
      }

      const switcher = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
      if (switcher) {
        const alternate = new URL(switcher.href);
        const updateLanguageLink = () => {
          alternate.search = window.location.search;
          alternate.hash = window.location.hash;
          switcher.href = alternate.href;
        };

        updateLanguageLink();
        window.addEventListener('hashchange', updateLanguageLink);
        window.addEventListener('pageshow', updateLanguageLink);
      }
    </script>
  </body>
</html>

<style>
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .language-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid #ffffff40;
    border-radius: 100px;
    background: var(--panel);
    font-size: 13px;
    line-height: 1.25;
    white-space: nowrap;
  }

  .language-switch > * {
    display: grid;
    min-width: 44px;
    min-height: 32px;
    place-items: center;
    padding: 0 8px;
    border-radius: inherit;
  }

  .language-switch > a:hover {
    color: var(--yellow);
  }

  .language-switch > [aria-current] {
    background: var(--yellow);
    color: var(--bg);
    font-weight: 800;
  }

  :is(.language-switch a, #site-nav a, .wordmark, .menu-toggle):focus-visible {
    outline: 2px solid var(--yellow);
    outline-offset: 3px;
  }

  @media (max-width: 950px) {
    .site-header {
      gap: 8px;
      padding-inline: max(4vw, 12px);
    }

    .menu-toggle {
      min-width: 44px;
      min-height: 44px;
      line-height: 1;
      cursor: pointer;
    }
  }
</style>
