---
import { ClientRouter } from 'astro:transitions';
import { SiteHeader, SiteFooter } from '../components/Shell';
import { assetHref, defaultLocale, languages, locales, pageHref, type Locale, type PageKey } from '../i18n';
import data from '../data/copy.json';
import '../styles/site.css';
import { nativeFontCSS, nativeHeadingFont } from '../fonts';

interface Props {
  lang: Locale;
  page: PageKey;
  metadata?: [string, string];
  alternates?: Partial<Record<Locale, string>>;
}
const { lang, page, metadata, alternates } = Astro.props;
const [title, description] = metadata ?? data.metadata[page][languages[lang].index];
const absolutePage = (locale: Locale) => new URL(alternates?.[locale] ?? pageHref(locale, page), Astro.site ?? Astro.url);
const estedad = assetHref('type/estedad-fa.woff2');
const sora = assetHref('type/sora-bold.woff2');
const manrope = assetHref('type/manrope.woff2');
const headingFont = nativeHeadingFont(lang);
const release = process.env.GITHUB_SHA || 'local';
---
<!doctype html>
<html lang={lang} dir={languages[lang].direction} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#20201d" />
    <meta name="jigsaw-release" content={release} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolutePage(lang)} />
    {locales.filter(locale => !alternates || alternates[locale]).map((locale) => <link rel="alternate" hreflang={locale} href={absolutePage(locale)} />)}
    <link rel="alternate" hreflang="x-default" href={absolutePage(alternates && !alternates[defaultLocale] ? lang : defaultLocale)} />
    <link rel="icon" type="image/webp" href={assetHref('media/mark.webp')} />
    <link rel="preload" as="font" type={headingFont.endsWith(".ttf") ? "font/ttf" : "font/woff2"} href={headingFont} crossorigin="anonymous" />
    <style is:inline set:html={`
      @font-face {
        font-family: Estedad;
        src: url("${estedad}") format("woff2");
        font-weight: 100 900;
        font-display: swap;
      }
      @font-face {
        font-family: Sora;
        src: url("${sora}") format("woff2");
        font-weight: 700;
        font-display: swap;
      }
      @font-face {
        font-family: Manrope;
        src: url("${manrope}") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
    `}></style>
    <style is:inline set:html={nativeFontCSS}></style>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader language={lang} page={page} alternates={alternates} />
    <main id="main" transition:animate="fade"><slot /></main>
    <SiteFooter language={lang} />
    <script>
      import "../scripts/studio.js";
    </script>
  </body>
</html>
