---
import { SiteHeader, SiteFooter } from '../components/Shell';
import { assetHref, defaultLocale, languages, locales, pageHref, type Locale, type PageKey } from '../i18n';
import data from '../data/copy.json';
import '../styles/site.css';

interface Props {
  lang: Locale;
  page: PageKey;
}
const { lang, page } = Astro.props;
const [title, description] = data.metadata[page][lang === 'fa' ? 0 : 1];
const absolutePage = (locale: Locale) => new URL(pageHref(locale, page), Astro.site ?? Astro.url);
const font = lang === 'fa' ? 'estedad-fa' : 'sora-bold';
---
<!doctype html>
<html lang={lang} dir={languages[lang].direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#20201d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolutePage(lang)} />
    {locales.map((locale) => <link rel="alternate" hreflang={locale} href={absolutePage(locale)} />)}
    <link rel="alternate" hreflang="x-default" href={absolutePage(defaultLocale)} />
    <link rel="icon" type="image/webp" href={assetHref('media/mark.webp')} />
    <link rel="preload" as="font" type="font/woff2" href={assetHref(`type/${font}.woff2`)} crossorigin="anonymous" />
  </head>
  <body>
    <SiteHeader language={lang} page={page} />
    <main id="main"><slot /></main>
    <SiteFooter language={lang} />
    <script is:inline src={assetHref('studio.js')} defer></script>
  </body>
</html>
